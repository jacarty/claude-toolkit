{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git restore:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git branch:*)",
      "Bash(git -C:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*.jks)",
      "Read(/**/*.keystore)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Read(/**/id_ecdsa)",
      "Read(/**/id_dsa)",
      "Read(/**/*.secret)",
      "Read(/**/*.password)",
      "Read(/**/.netrc)",
      "Read(/**/.git-credentials)",
      "Read(/private/**)",
      "Read(/**/secrets/**)",
      "Read(/**/credentials/**)",
      "Read(/**/.aws/credentials)",
      "Read(/**/.aws/config)",
      "Read(/**/.kube/config)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(/**/*.tfvars)",
      "Read(/**/*.tfvars.json)",
      "Read(/**/*.tfstate)",
      "Read(/**/*.tfstate.*)",
      "Read(/**/backend.conf)",
      "Read(/**/backend-*.conf)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
