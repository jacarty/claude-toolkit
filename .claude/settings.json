{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*.jks)",
      "Read(/**/*.keystore)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Read(/**/id_ecdsa)",
      "Read(/**/id_dsa)",
      "Read(/**/*.secret)",
      "Read(/**/*.password)",
      "Read(/**/.netrc)",
      "Read(/**/.git-credentials)",
      "Read(/**/.secrets)",
      "Read(/**/.secrets/**)",
      "Read(/**/secrets.json)",
      "Read(/private/**)",
      "Read(/**/secrets/**)",
      "Read(/**/credentials/**)",
      "Read(/**/.aws/credentials)",
      "Read(/**/.aws/config)",
      "Read(/**/.kube/config)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.azure/**)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.terraformrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(/**/*.tfvars)",
      "Read(/**/*.tfvars.json)",
      "Read(/**/*.tfstate)",
      "Read(/**/*.tfstate.*)",
      "Read(/**/backend.conf)",
      "Read(/**/backend-*.conf)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
