{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  // REFERENCE ONLY — Claude Code does not load this file.
  //
  // The live file is .claude/settings.json. Claude Code reads it as strict
  // JSON: a `//` comment or a trailing comma is a syntax error, and the whole
  // file is skipped (no permissions, no hooks). So the explanations and the
  // optional entries live here instead.
  //
  // When you create a repo from this template: copy the optional entries you
  // want from below into the matching list in .claude/settings.json, without
  // the comments. Then run /status in Claude Code to confirm the file loaded,
  // and `claude doctor` to see any entry it rejected.
  //
  // Entries in `allow` pre-approve tool invocations so Claude Code doesn't
  // prompt for confirmation on every use. Only pre-approve things you trust
  // Claude Code to run unattended — anything destructive or that touches
  // external state should be left out (or removed if added by default).
  //
  // The defaults (already in settings.json) cover common dev workflow: git,
  // GitHub CLI, Node/npm, Python testing/linting, basic shell utilities, web
  // search. Anything cloud-specific, IaC-specific, or MCP-specific is
  // commented out below.
  //
  // Docs: https://code.claude.com/docs/en/settings

  "permissions": {
    "allow": [
      // ── Git (read + write) ───────────────────────────────────────────────
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git restore:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git branch:*)",
      "Bash(git -C:*)",

      // ── GitHub CLI ───────────────────────────────────────────────────────
      "Bash(gh:*)",

      // ── Node.js ──────────────────────────────────────────────────────────
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",

      // ── Python: generic test + lint runners ──────────────────────────────
      // These assume `pytest` and `ruff` are on PATH (system, pipx, or
      // activated venv). If you use poetry, run `poetry shell` first or
      // prefix commands with `poetry run`.
      "Bash(python -m pytest:*)",
      "Bash(python3 -m:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",

      // ── Python: uv + project-local virtualenv paths ─────────────────────
      // Uncomment if your project uses uv or a `.venv/` directory at the
      // repo root (the convention used by `uv venv`, `python -m venv .venv`,
      // etc). The `uv` entry covers `uv run`, `uv sync`, `uv pip`, etc.
      // "Bash(uv:*)",
      // "Bash(.venv/bin/python:*)",
      // "Bash(.venv/bin/pytest:*)",
      // "Bash(.venv/bin/pip:*)",

      // ── Shell utilities (read-only / safe) ───────────────────────────────
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",

      // ── Cloud CLIs (opt in per project) ──────────────────────────────────
      // AWS and Terraform commands can be destructive. Uncomment only if
      // you're working in a cloud project AND you trust Claude Code to run
      // these without confirmation. Consider scoping more tightly (e.g.
      // `Bash(aws s3 ls:*)` instead of all of `aws:*`) for production work.
      // "Bash(aws:*)",
      // "Bash(terraform:*)",

      // ── Web ──────────────────────────────────────────────────────────────
      "WebSearch"

      // ── Linear MCP (opt in per project) ──────────────────────────────────
      // Uncomment if you have the Linear MCP server connected AND want
      // Claude Code to query/update your Linear workspace without prompting.
      // The block below pre-approves the full read+write surface; trim to
      // just the list_*/get_* entries for read-only access.
      //
      // "mcp__claude_ai_Linear__list_issues",
      // "mcp__claude_ai_Linear__list_projects",
      // "mcp__claude_ai_Linear__list_milestones",
      // "mcp__claude_ai_Linear__list_comments",
      // "mcp__claude_ai_Linear__list_cycles",
      // "mcp__claude_ai_Linear__list_documents",
      // "mcp__claude_ai_Linear__list_issue_labels",
      // "mcp__claude_ai_Linear__list_issue_statuses",
      // "mcp__claude_ai_Linear__list_project_labels",
      // "mcp__claude_ai_Linear__list_teams",
      // "mcp__claude_ai_Linear__list_users",
      // "mcp__claude_ai_Linear__get_issue",
      // "mcp__claude_ai_Linear__get_issue_status",
      // "mcp__claude_ai_Linear__get_milestone",
      // "mcp__claude_ai_Linear__get_project",
      // "mcp__claude_ai_Linear__get_team",
      // "mcp__claude_ai_Linear__get_user",
      // "mcp__claude_ai_Linear__get_document",
      // "mcp__claude_ai_Linear__get_attachment",
      // "mcp__claude_ai_Linear__search_documentation",
      // "mcp__claude_ai_Linear__extract_images",
      // "mcp__claude_ai_Linear__save_issue",
      // "mcp__claude_ai_Linear__save_milestone",
      // "mcp__claude_ai_Linear__save_project",
      // "mcp__claude_ai_Linear__save_comment",
      // "mcp__claude_ai_Linear__create_attachment",
      // "mcp__claude_ai_Linear__create_document",
      // "mcp__claude_ai_Linear__create_issue_label",
      // "mcp__claude_ai_Linear__update_document"
    ],

    // ── Deny: files Claude must not read ───────────────────────────────────
    // A Read deny rule also blocks Edit and Write on the same path. It covers
    // Claude's file tools, `@file` mentions, and file commands Claude Code
    // recognises in Bash (cat, head, tail, sed, tee, redirections). It does
    // NOT stop a script or `grep -r` that reads files without naming them;
    // for OS-level enforcement, enable the sandbox.
    //
    // `/**/x` matches x anywhere in the project (anchored at the project
    // root); `~/x` is under your home directory; an unanchored `x` matches at
    // any depth below the current directory. Paths use gitignore syntax. A
    // `!x` rule carves x back out of the unanchored rules listed before it.
    // Add your own secret locations here. (This replaces .claudeignore,
    // which Claude Code never supported.)
    "deny": [
      // Environment files. Unanchored on purpose: a `!` carve-out only reopens
      // paths for unanchored rules, and these keep committed templates readable.
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",

      // Private keys and credentials. `*.pem` and `*.key` can also match public
      // certificates or test fixtures; narrow them if that gets in the way.
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Read(/**/*.jks)",
      "Read(/**/*.keystore)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Read(/**/id_ecdsa)",
      "Read(/**/id_dsa)",
      "Read(/**/*.secret)",
      "Read(/**/*.password)",
      "Read(/**/.netrc)",
      "Read(/**/.git-credentials)",

      // Secret directories. `secrets/` and `credentials/` match at any depth, which
      // also catches source or k8s directories with those names. Narrow or
      // remove these if your project has code there (a Read deny also blocks
      // editing). `/private/` is the project root only.
      "Read(/private/**)",
      "Read(/**/secrets/**)",
      "Read(/**/credentials/**)",
      "Read(/**/.aws/credentials)",
      "Read(/**/.aws/config)",
      "Read(/**/.kube/config)",

      // Credentials in your home directory
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",

      // Opt in per project: uncomment to add (often committed with registry
      // settings only, but can hold tokens)
      // "Read(/**/.npmrc)",
      // "Read(/**/.pypirc)",
      // "Read(/**/.envrc)",

      // Cloud / IaC state and variables (may contain secrets)
      "Read(/**/*.tfvars)",
      "Read(/**/*.tfvars.json)",
      "Read(/**/*.tfstate)",
      "Read(/**/*.tfstate.*)",
      "Read(/**/backend.conf)",
      "Read(/**/backend-*.conf)"
    ]
  },

  // ── Hooks (already in settings.json) ─────────────────────────────────────
  // After every edit, format and lint the file with the project's own
  // installed and configured tools (see .claude/hooks/lint-edited-file.sh).
  // Leftover issues go back to Claude. Replaces the old `linter` subagent at
  // no token cost. Remove this block to turn it off.
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
